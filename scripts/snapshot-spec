#!/usr/bin/env bash
# Pull a versioned snapshot of the upstream GATIS spec into spec/.
#
# Source: the dotbts/BPA repository, pinned by commit SHA in spec/MANIFEST.json.
# GATIS v1.0 was voted through on 2026-02-27 and is published from that repo; the
# Google Sheets drafts this script used to export are superseded (upstream's README
# labels the sheet we pinned "Draft #2"). See spec/README.md.
#
#   specification_jsons/*.json -> spec/specification/    the generation source
#   json_schemas/*.json        -> spec/json-schemas/     upstream's own validator
#   gatis_explorer/data/**     -> spec/explorer/         CSV mirror, a cross-check
#   pages/specification_introduction.html -> spec/introduction.html   the prose
#
# Pass a commit SHA, tag or branch to move the pin; defaults to the pinned commit.
# Requires `gh` (authenticated) and `jq`.
set -euo pipefail

REPO=dotbts/BPA
DEFAULT_REF=ecc45ff86fba1cfeb76508d1569412ae894a9adc

main() {
  local root spec ref sha tarball stage prefix
  root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
  spec="$root/spec"
  ref=${1:-$DEFAULT_REF}

  command -v gh >/dev/null || { echo "gh not on PATH" >&2; exit 1; }
  command -v jq >/dev/null || { echo "jq not on PATH" >&2; exit 1; }

  echo "==> resolving $REPO@$ref"
  local commit
  commit=$(gh api "repos/$REPO/commits/$ref")
  sha=$(jq -r '.sha' <<<"$commit")

  stage=$(mktemp -d)
  # shellcheck disable=SC2064
  trap "rm -rf '$stage'" EXIT

  echo "==> fetching tarball $sha"
  tarball="$stage/repo.tar.gz"
  gh api "repos/$REPO/tarball/$sha" > "$tarball"
  tar xzf "$tarball" -C "$stage"
  prefix=$(find "$stage" -maxdepth 1 -type d -name '*-BPA-*' -print -quit)
  [ -n "$prefix" ] || { echo "unexpected tarball layout" >&2; exit 1; }

  echo "==> staging spec/"
  rm -rf "$spec/specification" "$spec/json-schemas" "$spec/explorer"
  mkdir -p "$spec/specification" "$spec/json-schemas" "$spec/explorer"

  cp "$prefix"/draft_gatis_specification/specification_jsons/*.json "$spec/specification/"
  cp "$prefix"/draft_gatis_specification/json_schemas/*.json "$spec/json-schemas/"
  cp -R "$prefix"/gatis_explorer/data/. "$spec/explorer/"
  cp "$prefix"/gatis_explorer/pages/specification_introduction.html "$spec/introduction.html"

  echo "==> writing MANIFEST.json"
  write_manifest "$spec" "$commit"

  echo "done: $(find "$spec" -type f \( -name '*.json' -o -name '*.csv' -o -name '*.html' \) \
    -not -name MANIFEST.json | wc -l | tr -d ' ') files from $REPO@${sha:0:8}"
}

write_manifest() {
  local spec=$1 commit=$2
  jq -n \
    --argjson commit "$commit" \
    --arg repo "$REPO" \
    --arg fetched "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --argjson files "$(checksums "$spec")" \
    '{
       fetched_at: $fetched,
       source: {
         repo: $repo,
         url: ("https://github.com/" + $repo),
         commit: $commit.sha,
         commit_date: $commit.commit.author.date,
         commit_subject: ($commit.commit.message | split("\n")[0])
       },
       files: $files
     }' > "$spec/MANIFEST.json"
}

checksums() {
  ( cd "$1" && find . -type f \( -name '*.json' -o -name '*.csv' -o -name '*.html' \) \
      -not -name MANIFEST.json \
      | sed 's|^\./||' | sort \
      | while IFS= read -r f; do
          jq -n --arg p "$f" \
                --arg s "$(shasum -a 256 "$f" | cut -d' ' -f1)" \
                --argjson b "$(wc -c < "$f" | tr -d ' ')" \
            '{path: $p, sha256: $s, bytes: $b}'
        done | jq -s '.' )
}

main "$@"; exit $?
