#!/usr/bin/env bash
# Download the published GATIS sample datasets into sample-data/ (gitignored).
#
# There is no single place to get these. The GATIS Explorer's sample-datasets
# page contains no data: it is a shell that fetches maps.json at runtime and
# iframes ~30 MB Folium maps. Newark's GeoJSON is committed to dotbts/BPA;
# Austin's is not in any repository, and lives as ArcGIS items whose ids appear
# only inside HTML strings in maps.json.
#
# Austin's edges file is ~280 MB and is the full dataset, not the clipped
# sample the map shows. Pass --skip-austin-edges to leave it.
#
# Neither file declares a spec version and both predate the commit spec/ pins,
# so expect vocabulary GATIS v1.0 has since renamed. See
# docs/sample-data-validation.md.
set -euo pipefail

REPO=dotbts/BPA
RAW=https://raw.githubusercontent.com
ARCGIS=https://usdot.maps.arcgis.com/sharing/rest/content/items

# The commit spec/MANIFEST.json pins, so the data and the spec it is checked
# against come from one upstream state. Upstream force-pushes, so tracking a
# branch would make the counts in docs/ unreproducible. Override with
# GATIS_SAMPLE_REF -- and delete sample-data/ when you do, because a file
# already on disk is reused whatever ref it came from.
REF=${GATIS_SAMPLE_REF:-ecc45ff86fba1cfeb76508d1569412ae894a9adc}

# ArcGIS item ids, read out of maps.json's description HTML on 2026-09-21.
# Pinned rather than re-scraped: the ids are stable, the HTML around them is not.
AUSTIN_EDGES=85009c8a1f62415a938f75f671172d70
AUSTIN_NODES=9ef08fa4b51241e8b3b02549d83ea043

NEWARK=draft_gatis_specification/sample_data/newark_de

out=

usage() {
  cat <<'EOF'
usage: fetch-sample-data [--skip-austin-edges]

  --skip-austin-edges   leave Austin's ~280 MB edges file undownloaded
EOF
}

main() {
  local root arg skip_big=0
  for arg in "$@"; do
    case $arg in
      --skip-austin-edges) skip_big=1 ;;
      -h | --help) usage; return 0 ;;
      *) echo "unknown argument: $arg" >&2; usage >&2; return 2 ;;
    esac
  done

  command -v curl >/dev/null || { echo "curl not on PATH" >&2; return 1; }
  command -v jq >/dev/null || { echo "jq not on PATH" >&2; return 1; }

  root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
  out="$root/sample-data"
  mkdir -p "$out"

  fetch newark_edges "$RAW/$REPO/$REF/$NEWARK/newarkDE_sample_edges.geojson"
  fetch newark_nodes "$RAW/$REPO/$REF/$NEWARK/newarkDE_sample_nodes.geojson"
  fetch austin_nodes "$ARCGIS/$AUSTIN_NODES/data"
  if (( skip_big )); then
    echo "skipped austin_edges (--skip-austin-edges)"
  else
    fetch austin_edges "$ARCGIS/$AUSTIN_EDGES/data"
  fi

  summary
}

is_collection() {
  jq -e 'has("features")' "$1" >/dev/null 2>&1
}

# Two ways to end up with a file that is not the dataset, and a size check sees
# neither: GitHub and ArcGIS both answer some errors with 200 and an HTML or
# JSON body, and an interrupted transfer leaves a truncated file that would be
# reused as complete on the next run. So each file is parsed before it counts
# as downloaded, and again before it is reused.
fetch() {
  local name=$1 url=$2 dest="$out/$1.geojson"
  if [[ -s $dest ]] && is_collection "$dest"; then
    echo "have    $name"
    return
  fi
  [[ -e $dest ]] && echo "refetch $name (on-disk copy is not a FeatureCollection)"
  rm -f "$dest"

  echo "fetch   $name"
  curl -fsSL -o "$dest.part" "$url"
  if ! is_collection "$dest.part"; then
    echo "error: $name did not download a FeatureCollection." >&2
    echo "       first bytes: $(head -c 120 "$dest.part")" >&2
    rm -f "$dest.part"
    return 1
  fi
  mv "$dest.part" "$dest"
}

summary() {
  local f
  echo
  for f in "$out"/*.geojson; do
    [[ -e $f ]] || continue
    printf '%-28s %8s features  %s\n' \
      "$(basename "$f")" \
      "$(jq '.features | length' "$f")" \
      "$(du -h "$f" | cut -f1)"
  done
  echo
  echo "validate with: ./scripts/validate-sample sample-data/<file>.geojson"
}

main "$@"
